# Copy to `.env` and fill in the real values. Never commit `.env`.
# Everything here is read once by src/config/env.js and validated at boot.

# ── Required ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Secrets: required when NODE_ENV=production ──────────────────────────────
# Guard for GET /api/applications (compare with x-api-key).
ADMIN_API_KEY=
# Guard for POST /api/internal/... (compare with x-internal-token).
INTERNAL_SERVICE_TOKEN=
# Pepper for PAN/Aadhaar hashes. Rotating it invalidates existing digests.
PII_HASH_PEPPER=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma separated origins. Empty = allow any origin (development only;
# production refuses to boot without it).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── reCAPTCHA v2 ────────────────────────────────────────────────────────────
# The site key is public and also served by GET /api/captcha/config.
RECAPTCHA_SITE_KEY=
# Server side only. Never exposed by an endpoint.
RECAPTCHA_SECRET_KEY=
# Comma separated hostnames a token may have been solved on. Empty = no check.
RECAPTCHA_ALLOWED_HOSTNAMES=
# Development escape hatch. Boot fails if this is true in production.
RECAPTCHA_DEV_BYPASS=false

# ── Authentication challenges ───────────────────────────────────────────────
# Returns the OTP in the challenge response. Boot fails in production if true.
# Without a real SMS/UIDAI gateway this is the only way to authenticate.
AUTH_DEV_MODE=false

# ── Session recovery (proving ownership when the session is gone) ───────────
# Master switch for POST /workflow/recovery/*.
RECOVERY_ENABLED=true
# Turn each factor on or off. A factor that cannot be verified must stay off.
RECOVERY_OTP_ENABLED=true
RECOVERY_CAPTCHA_ENABLED=true
# No identity provider is implemented in this build, so boot refuses `true`
# rather than pretending the check happened.
RECOVERY_IDENTITY_ENABLED=false
# Demand an identity check on top of the mobile code. With no provider
# configured, recovery then answers IDENTITY_PROVIDER_UNAVAILABLE.
RECOVERY_REQUIRE_IDENTITY=false
# OTP is only meaningful when a number is already on file for the applicant.
RECOVERY_REQUIRE_REGISTERED_MOBILE=true
# `none` = no gateway; recovery answers RECOVERY_DELIVERY_UNAVAILABLE.
# `dev` = code is generated but not sent (never returned); refused in production.
SMS_PROVIDER=none
RECOVERY_CHALLENGE_TTL_MINUTES=15
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_MAX_OTP_SENDS=3
RECOVERY_OTP_RESEND_SECONDS=60
RECOVERY_LOCKOUT_MINUTES=15
RECOVERY_MAX_STARTS_PER_HOUR=10

# ── Local flow simulation ───────────────────────────────────────────────────
# Answers INTERNAL verification nodes (face, PAN, bank, bureau, fraud,
# document, risk, eligibility, disbursement) with deterministic happy-path
# verdicts so the browser flow can be walked without provider accounts.
# Never enable in production; boot refuses it.
DEV_SIMULATE_INTERNAL_STEPS=false

# ── Tuning (defaults shown) ─────────────────────────────────────────────────
DATABASE_POOL_MAX=10
REQUEST_BODY_LIMIT=256kb
WORKFLOW_SESSION_TTL_MINUTES=720
ACTOR_SESSION_TTL_MINUTES=30
AUTH_CHALLENGE_TTL_MINUTES=5
# Lifetime of the HttpOnly resume credential. Deliberately longer than the
# session: it is what survives a cleared sessionStorage.
WORKFLOW_RECOVERY_TTL_HOURS=168
# Disbursement requests above this amount go to a manager's manual review.
DISBURSEMENT_MANUAL_REVIEW_THRESHOLD=500000
# Apply pending migrations on boot. Prefer `npm run migrate` in a deploy step.
MIGRATE_ON_BOOT=false
